{
  "name": "fieldshift-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:press && npm run check:words && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "check:press": "! grep -rnE \"active:[^ \\\"']*(scale|translate|rotate|skew)\" src",
    "check:words": "! grep -rnwiE \"alerts?|healthy|caused|recommend(ed|ation)?|profit|monoculture|you should|no problem|management problem|worst\" index.html src/App.tsx src/components/*.tsx src/lib/layers.ts",
    "check:data": "node --experimental-strip-types -e \"for (const f of ['data', 'layers', 'fields']) import('./src/lib/' + f + '.ts').then((m) => m.selfCheck())\""
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@turf/area": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "description": "Field Shift: crop-stress and rotation decision support on NASA data. Built with AI assistance (Claude Code)."
}
